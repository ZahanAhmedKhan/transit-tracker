# Copy this file to .env and fill in your real values.
# .env is ignored by git, so passwords and keys never go to GitHub.

# Supabase connection string (Connect -> Direct -> Session pooler).
# When this is set, every script uses it instead of the local settings below.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

# Read-only login for the deployed dashboard; written by create_dashboard_role.py.
DASHBOARD_DATABASE_URL=postgresql://dashboard_reader.your_project_ref:generated_password@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

# Metrolinx Open Data API key for live GO Transit data (see docs/setup.md).
METROLINX_API_KEY=your_key_here

# Local PostgreSQL (Phase 1). Used only when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transit
DB_USER=postgres
DB_PASSWORD=your_password_here
